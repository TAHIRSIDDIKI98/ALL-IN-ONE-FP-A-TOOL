# OneFP&A Environment Configuration Template (Placeholders ONLY — §3.5)
# Copy to .env locally for staging/dev. Sandbox tests (`npm run verify`) run on PGLite with zero secrets.

NODE_ENV=development
PORT=3001

# Neon PostgreSQL connection string (staging/production — pooled)
DATABASE_URL=postgresql://placeholder_user:placeholder_password@ep-placeholder.us-east-2.aws.neon.tech/onefpa?sslmode=require

# Firebase Authentication (server-side Admin SDK verification)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-placeholder@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPLACEHOLDER_ONLY_DO_NOT_USE\n-----END PRIVATE KEY-----\n"

# Client-safe Firebase public web config (only public app identifiers, never admin keys)
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_API_KEY=placeholder-public-firebase-web-identifier
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com

# Gemini API (SERVER-SIDE ONLY — never expose to VITE_* or client bundle; §10.3)
GEMINI_API_KEY=placeholder_gemini_server_key_do_not_commit
LLM_EGRESS_ENABLED=false
